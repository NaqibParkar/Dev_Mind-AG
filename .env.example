# Copy the relevant values into backend/.env and frontend/.env.local.
# Never commit the real files.

# Backend-only secrets
DATABASE_URL=sqlite:///./data/devmind.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
GEMINI_API_KEY=

# Public browser configuration (never put secrets in VITE_* values)
VITE_API_BASE_URL=http://localhost:8000

